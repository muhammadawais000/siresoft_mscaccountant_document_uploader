# Copy to .env and adjust. Never commit .env.

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# CORS: no CORS headers are emitted, so browsers block all cross-origin API calls.

# --- Database (docker compose exposes postgres on host port 55433)
DATABASE_URL=postgres://intake:intake@localhost:55433/intake

# --- Celery / Redis (docker compose exposes redis on host port 56380)
CELERY_BROKER_URL=redis://localhost:56380/0
CELERY_RESULT_BACKEND=redis://localhost:56380/1
# true = run tasks inline in the request (local dev without a worker, tests)
CELERY_TASK_ALWAYS_EAGER=false

# --- File storage (private, outside any public URL space)
INTAKE_PRIVATE_STORAGE_ROOT=./private_media
INTAKE_MAX_UPLOAD_MB=25

# --- Ollama (runs on the host or a separate server; weights are never bundled)
# From inside docker compose on Linux use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Vision model used for images and scanned PDFs. Pull it first: `ollama pull <name>`,
# then confirm with `python manage.py check_ollama`. Documented default; change freely.
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Optional text-only model for PDFs with a text layer. Empty = reuse the vision model.
OLLAMA_TEXT_MODEL=
OLLAMA_TIMEOUT_SECONDS=180

# --- Logging
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
