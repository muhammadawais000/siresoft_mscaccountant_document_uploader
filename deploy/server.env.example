# Copy to .env.server in the project folder (next to docker-compose.server.yml) and fill in.
# Never commit .env.server. After changes: make server-up
# Format: KEY=value, no quotes.

# --- Used by docker compose itself
POSTGRES_PASSWORD=change-me-strong-password
WEB_PORT=8003

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=SERVER-IP
DJANGO_CSRF_TRUSTED_ORIGINS=http://SERVER-IP:8003
# Testing over plain http (no Nginx / HTTPS yet): keep these three off.
# With HTTPS in front later: true, true, 31536000.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_HSTS_SECONDS=0

GUNICORN_WORKERS=3

# --- Uploads
INTAKE_MAX_UPLOAD_MB=25

# --- Ollama on the host (GPU). Ollama must listen on 0.0.0.0 (OLLAMA_HOST) so the
# containers can reach it through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=16384
OLLAMA_SCHEMA_MODE=prompt

# --- Logging (docker compose logs)
LOG_LEVEL=INFO
LOG_FORMAT=console
