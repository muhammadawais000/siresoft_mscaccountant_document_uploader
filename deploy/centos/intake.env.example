# Production settings for the systemd services. install.sh copies this to
# /etc/msc-intake/intake.env (once) and fills DJANGO_SECRET_KEY. Edit that file, then
# `sudo systemctl restart msc-intake.target`.
# Format: KEY=value, no quotes, no spaces around "=" (read by systemd and by bash).

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=intake.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://intake.example.com
# Until HTTPS is set up (testing on http://<server-ip>) set all three to false / 0.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database
DATABASE_URL=postgres://intake:CHANGE-ME@127.0.0.1:5432/intake

# --- Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_CONCURRENCY=1

# --- Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3

# --- File storage (private; never served by Nginx)
INTAKE_PRIVATE_STORAGE_ROOT=/var/lib/msc-intake/private_media
INTAKE_MAX_UPLOAD_MB=25

# --- Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=16384
OLLAMA_SCHEMA_MODE=prompt

# --- Logging (goes to journald: journalctl -u msc-intake-web -u msc-intake-worker)
LOG_LEVEL=INFO
LOG_FORMAT=json
